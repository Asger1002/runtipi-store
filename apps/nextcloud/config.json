      "required": false,
      "default": "1024M",
      "hint": "PHP memory limit (512M, 1024M, 2048M, 4096M)",
      "env_variable": "PHP_MEMORY_LIMIT"
    },
    {
      "type": "text",
      "label": "PHP Upload Limit",
      "max": 5,
      "min": 4,
      "required": false,
      "default": "1024M",
      "hint": "PHP upload limit (512M, 1024M, 2048M, 4096M)",
      "env_variable": "PHP_UPLOAD_LIMIT"
    }
  ],
  "supported_architectures": ["amd64"],
