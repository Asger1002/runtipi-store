  "description": "Nextcloud 35 with built-in Collabora (LibreOffice-based) document and spreadsheet editing. Accessible over Tailscale via https://nextcloud.hs1.catla-spica.ts.net — no public internet exposure, no Cloudflare. Includes PostgreSQL 17, Redis, and a background cron container.",
  "short_desc": "Nextcloud 35 + Collabora office suite, Tailscale-first",
  "author": "Nextcloud GmbH",
  "source": "https://github.com/nextcloud/server",
  "website": "https://nextcloud.com/",
  "form_fields": [
    {
      "type": "text",
      "label": "Username",
      "max": 50,
      "min": 3,
      "required": true,
      "env_variable": "NEXTCLOUD_ADMIN_USER"
    },
    {
      "type": "password",
      "label": "Password",
      "max": 50,
      "min": 10,
      "required": true,
      "env_variable": "NEXTCLOUD_ADMIN_PASSWORD"
    },
    {
      "type": "text",
      "label": "PHP Memory Limit",
      "max": 5,
