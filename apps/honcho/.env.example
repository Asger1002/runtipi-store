# Honcho Environment Configuration
# Copy this to configure your Honcho instance after install.
#
# The LLM API key is set via the Tipi install form (→ app.env → LLM_OPENAI_API_KEY).
# For advanced config, edit the .env file in your app data directory:
#   /path/to/runtipi/app-data/honcho/data/.env

# ── LLM Provider (REQUIRED) ──────────────────────────────────────────
# The server will fail to start without a provider configured.
# Models must support tool calling (function calling).

# OpenAI / OpenRouter / Any OpenAI-compatible endpoint:
LLM_OPENAI_API_KEY=sk-...

# Override per-feature model and endpoint (example for OpenRouter):
# DERIVER_MODEL_CONFIG__TRANSPORT=openai
# DERIVER_MODEL_CONFIG__MODEL=google/gemini-2.5-flash
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
#
# SUMMARY_MODEL_CONFIG__TRANSPORT=openai
# SUMMARY_MODEL_CONFIG__MODEL=google/gemini-2.5-flash
# SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# Alternative providers (uncomment one and set the key):
# LLM_ANTHROPIC_API_KEY=sk-ant-...
# LLM_GEMINI_API_KEY=...

# ── Default Models ───────────────────────────────────────────────────
# Text generation: gpt-5.4-mini (OpenAI)
# Embeddings: text-embedding-3-small (1536 dims, OpenAI)
# Each feature module (Deriver, Dialectic, Summary, Dream) has its own
# model config that can be overridden independently.

# ── Authentication ───────────────────────────────────────────────────
# Set to true for production. Requires AUTH_JWT_SECRET.
AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=generate-with: python scripts/generate_jwt_secret.py

# ── Vector Store ─────────────────────────────────────────────────────
# Supported: pgvector (default), turbopuffer, lancedb
# VECTOR_STORE_TYPE=pgvector

# ── Monitoring ───────────────────────────────────────────────────────
# SENTRY_DSN=
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
